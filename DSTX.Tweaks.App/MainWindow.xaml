<Window x:Class="DSTX.Tweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DSTX.Tweaks.App.Models"
        Title="DSTX Tweaks v0.8" WindowState="Maximized" MinWidth="1280" MinHeight="820">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="156"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="398"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DSTX Tweaks" FontSize="29" FontWeight="Black" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Aggressive gaming optimizer" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Height="42"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search actions, apps, reports..."/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#07140D" BorderBrush="#14532D" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,0,10,0">
                        <TextBlock Text="Valorant Guard ON" Foreground="#A7F3D0" FontWeight="Bold"/>
                    </Border>
                    <ToggleButton Width="132"
                                  Height="38"
                                  IsChecked="{Binding OverrideGuard}"
                                  Content="Override OFF"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,14,14,14" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <Border Background="#101016" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="14">
                    <StackPanel>
                        <TextBlock Text="NAVIGATION" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                        <TextBlock Text="Real pages, not filtered lists" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PageItem}">
                                <Button Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Height="44"
                                        Margin="0,0,0,8"
                                        Background="{Binding IsSelected, Converter={StaticResource BooleanToSelectedBrushConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="9" Background="#18121A" BorderBrush="#31212B" BorderThickness="1">
                                            <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="11"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Group}" FontSize="10" Foreground="{StaticResource Muted2Brush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#07070B" BorderBrush="#2B2027" BorderThickness="1" CornerRadius="10" Padding="7,3">
                                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#07070B" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SELECTED" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                            <TextBlock Text="{Binding SelectedCountLabel}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1B1218" BorderBrush="#7A0F24" BorderThickness="1" CornerRadius="14" Padding="10,7">
                            <TextBlock Text="{Binding CurrentPage.Count}" FontWeight="Black"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Margin="0,14,14,14" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.Name}" FontSize="28" FontWeight="Black"/>
                        <TextBlock Text="{Binding CurrentPage.Description}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="ENABLE EVERYTHING" Style="{StaticResource PrimaryButton}" Width="178" Height="42" Margin="0,0,8,0" Command="{Binding EnableEverythingCommand}"/>
                        <Button Content="APPLY SELECTED" Style="{StaticResource AccentButton}" Width="154" Height="42" Margin="0,0,8,0" Command="{Binding ApplySelectedCommand}"/>
                        <Button Content="UNDO SELECTED" Width="124" Height="42" Margin="0,0,8,0" Command="{Binding UndoSelectedCommand}"/>
                        <Button Content="REPORT ZIP" Width="108" Height="42" Command="{Binding ExportReportCommand}"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,12">
                    <Border Background="#0C0D12" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="GUARD" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                            <TextBlock Text="VALORANT ON" Foreground="#A7F3D0" FontSize="15" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0C0D12" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="MODE" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                            <TextBlock Text="AGGRESSIVE" FontSize="15" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0C0D12" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="BACKUP" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                            <TextBlock Text="FIRST" Foreground="#FCD34D" FontSize="15" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0C0D12" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="14">
                        <StackPanel>
                            <TextBlock Text="QUEUE" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                            <TextBlock Text="{Binding QueueCountLabel}" Foreground="#C4B5FD" FontSize="15" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TweakActionItem}">
                                <Border Width="382"
                                        MinHeight="126"
                                        CornerRadius="20"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="#1B161D"
                                        BorderThickness="1"
                                        Padding="16"
                                        Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="{Binding Name}"
                                                    Command="{Binding DataContext.SelectActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Left"
                                                    FontWeight="Black"
                                                    Padding="0"/>
                                            <Border Grid.Column="2" Background="{Binding Risk, Converter={StaticResource RiskBrushConverter}}" CornerRadius="999" Padding="8,5">
                                                <TextBlock Text="{Binding Risk}" FontSize="10" FontWeight="Black"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Short}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19"
                                                   Margin="0,10,0,12"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Border Background="#07070B" BorderBrush="#241A21" BorderThickness="1" CornerRadius="999" Padding="8,5" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                                            </Border>
                                            <Border Background="#07070B" BorderBrush="#241A21" BorderThickness="1" CornerRadius="999" Padding="8,5">
                                                <TextBlock Text="{Binding RestartLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Details drawer -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Margin="0,14,0,14" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="ACTION DETAILS" Foreground="{StaticResource Muted2Brush}" FontSize="11" FontWeight="Black"/>
                    <TextBlock Text="{Binding SelectedAction.Name}" FontSize="24" FontWeight="Black" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{Binding SelectedAction.Risk, Converter={StaticResource RiskBrushConverter}}" CornerRadius="999" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SelectedAction.Risk}" FontSize="11" FontWeight="Black"/>
                        </Border>
                        <Border Background="#07070B" BorderBrush="#241A21" BorderThickness="1" CornerRadius="999" Padding="10,6">
                            <TextBlock Text="{Binding SelectedAction.RestartLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,16">
                    <StackPanel>
                        <Border Background="#07070B" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What it does" FontWeight="Black" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedAction.Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#07070B" BorderBrush="#1B161D" BorderThickness="1" CornerRadius="18" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Command preview" FontWeight="Black" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SelectedAction.CommandPreview}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         MinHeight="140"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Content="APPLY THIS" Style="{StaticResource AccentButton}" Height="42" Margin="0,0,0,8" Command="{Binding ApplyThisCommand}"/>
                    <Button Content="UNDO THIS" Height="40" Margin="0,0,0,8" Command="{Binding UndoThisCommand}"/>
                    <Button Content="COPY COMMANDS" Height="40" Margin="0,0,0,8" Command="{Binding CopyCommandsCommand}"/>
                    <Button Content="OPEN BACKUP / LOG FOLDER" Height="40" Command="{Binding OpenLogsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom queue/log -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="14" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TASK QUEUE" Foreground="{StaticResource Muted2Brush}" FontWeight="Black" FontSize="11"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding TaskQueue}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TaskItem}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="LIVE LOG" DockPanel.Dock="Left" Foreground="{StaticResource Muted2Brush}" FontWeight="Black" FontSize="11"/>
                        <TextBlock Text="All · Commands · Warnings · Errors · Skipped" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             Text="{Binding LiveLog}"
                             Background="#050506"
                             Foreground="{StaticResource MutedBrush}"
                             BorderBrush="#1B161D"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
